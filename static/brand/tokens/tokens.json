{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "undust design tokens v1.0 — agrège colors.json (prompt 02) + scale.json (prompt 03) + spacing/radius/border/shadow/z/transition.",

  "color": { "$ref": "../palette/colors.json#/color" },
  "font":  { "$ref": "../typography/scale.json#/font" },
  "weight":{ "$ref": "../typography/scale.json#/weight" },
  "scale": { "$ref": "../typography/scale.json#/scale" },

  "spacing": {
    "$description": "Base 4px. Suit la grille 4-8-12-16-20-24-32-48-64-96-128.",
    "0":  { "$value": "0",     "$type": "dimension" },
    "1":  { "$value": "4px",   "$type": "dimension" },
    "2":  { "$value": "8px",   "$type": "dimension" },
    "3":  { "$value": "12px",  "$type": "dimension" },
    "4":  { "$value": "16px",  "$type": "dimension" },
    "5":  { "$value": "20px",  "$type": "dimension" },
    "6":  { "$value": "24px",  "$type": "dimension" },
    "8":  { "$value": "32px",  "$type": "dimension" },
    "10": { "$value": "40px",  "$type": "dimension" },
    "12": { "$value": "48px",  "$type": "dimension" },
    "16": { "$value": "64px",  "$type": "dimension" },
    "20": { "$value": "80px",  "$type": "dimension" },
    "24": { "$value": "96px",  "$type": "dimension" },
    "32": { "$value": "128px", "$type": "dimension" }
  },

  "radius": {
    "none": { "$value": "0",    "$type": "dimension" },
    "sm":   { "$value": "4px",  "$type": "dimension" },
    "md":   { "$value": "8px",  "$type": "dimension", "$description": "Standard card chamfer (DESIGN-SYSTEM.md)" },
    "lg":   { "$value": "12px", "$type": "dimension", "$description": "chamfer-lg : tuiles terrain" },
    "xl":   { "$value": "16px", "$type": "dimension" },
    "full": { "$value": "9999px","$type": "dimension" }
  },

  "border-width": {
    "1": { "$value": "1px", "$type": "dimension", "$description": "Standard" },
    "2": { "$value": "2px", "$type": "dimension", "$description": "Emphasis" },
    "4": { "$value": "4px", "$type": "dimension", "$description": "Critical (border-left card.accent)" }
  },

  "shadow": {
    "none": { "$value": "none", "$type": "shadow" },
    "sm":   { "$value": "0 1px 2px rgba(0,0,0,0.18)",                      "$type": "shadow" },
    "md":   { "$value": "0 4px 12px rgba(0,0,0,0.25)",                     "$type": "shadow" },
    "lg":   { "$value": "0 12px 32px rgba(0,0,0,0.32)",                    "$type": "shadow" },
    "glow-accent": { "$value": "0 0 24px rgba(255,107,53,0.18)",           "$type": "shadow" },
    "glow-teal":   { "$value": "0 0 24px rgba(74,127,138,0.18)",           "$type": "shadow" }
  },

  "z-index": {
    "base":             { "$value": 0,   "$type": "number" },
    "dropdown":         { "$value": 100, "$type": "number" },
    "sticky":           { "$value": 200, "$type": "number" },
    "fixed":            { "$value": 300, "$type": "number" },
    "modal-backdrop":   { "$value": 400, "$type": "number" },
    "modal":            { "$value": 500, "$type": "number" },
    "popover":          { "$value": 600, "$type": "number" },
    "tooltip":          { "$value": 700, "$type": "number" }
  },

  "transition": {
    "fast":  { "$value": "150ms cubic-bezier(0.4, 0, 0.2, 1)", "$type": "transition" },
    "base":  { "$value": "250ms cubic-bezier(0.4, 0, 0.2, 1)", "$type": "transition" },
    "slow":  { "$value": "400ms cubic-bezier(0.4, 0, 0.2, 1)", "$type": "transition" }
  }
}
