{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "font": {
    "display": {
      "$value": "'Titillium Web', 'Helvetica Neue', Arial, sans-serif",
      "$type": "fontFamily",
      "$description": "Titres, wordmark, stats. Google Fonts OFL. Weights : 300 / 400 / 600 / 700 + 300italic."
    },
    "mono": {
      "$value": "'JetBrains Mono', ui-monospace, 'Cascadia Code', Menlo, Consolas, monospace",
      "$type": "fontFamily",
      "$description": "Body, chiffres tabulaires, code, kickers. Google Fonts OFL. Weights : 400 / 500 + italiques."
    }
  },
  "weight": {
    "light":     { "$value": 300, "$type": "fontWeight" },
    "regular":   { "$value": 400, "$type": "fontWeight" },
    "medium":    { "$value": 500, "$type": "fontWeight" },
    "semibold":  { "$value": 600, "$type": "fontWeight" },
    "bold":      { "$value": 700, "$type": "fontWeight" }
  },
  "scale": {
    "$description": "11 niveaux. Body min 16px (14px notes acceptables). Slide body min 22px. Bullet visio Teams 80% min 17px effectif.",
    "display": {
      "size": "3.5rem",  "px": "56px", "line": 1.1,  "weight": 700, "tracking": "-0.02em",
      "family": "display", "usage": "Slide cover titre, hero pitch"
    },
    "h1": {
      "size": "2.25rem", "px": "36px", "line": 1.15, "weight": 700, "tracking": "-0.015em",
      "family": "display", "usage": "Page principale, slide H1 standard"
    },
    "h2": {
      "size": "1.75rem", "px": "28px", "line": 1.2,  "weight": 600, "tracking": "-0.01em",
      "family": "display", "usage": "Section, slide H2"
    },
    "h3": {
      "size": "1.375rem","px": "22px", "line": 1.25, "weight": 600, "tracking": "-0.005em",
      "family": "display", "usage": "Sous-section, card title slide"
    },
    "h4": {
      "size": "1.125rem","px": "18px", "line": 1.3,  "weight": 600, "tracking": "0",
      "family": "display", "usage": "Card title web, label fort"
    },
    "body-lg": {
      "size": "1.125rem","px": "18px", "line": 1.55, "weight": 400, "tracking": "0",
      "family": "mono",    "usage": "Paragraphe principal, lead, intro"
    },
    "body": {
      "size": "1rem",    "px": "16px", "line": 1.55, "weight": 400, "tracking": "0",
      "family": "mono",    "usage": "Corps standard"
    },
    "body-sm": {
      "size": "0.875rem","px": "14px", "line": 1.5,  "weight": 400, "tracking": "0",
      "family": "mono",    "usage": "Note, footer, meta dense"
    },
    "caption": {
      "size": "0.75rem", "px": "12px", "line": 1.4,  "weight": 400, "tracking": "0.02em",
      "family": "mono",    "usage": "Date, durée, légende discrete"
    },
    "mono-quote": {
      "size": "0.875rem","px": "14px", "line": 1.55, "weight": 400, "tracking": "0",
      "family": "mono",    "usage": "Citation code/inline, verbatim"
    },
    "eyebrow": {
      "size": "0.75rem", "px": "12px", "line": 1.4,  "weight": 500, "tracking": "0.22em",
      "family": "mono",    "usage": "Kicker shouting, uppercase, ancrage section"
    }
  }
}
